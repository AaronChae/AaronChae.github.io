{% assign gh_user = site.data.socials.github_username %}
<div class="gh-contrib" id="gh-contrib" data-user="{{ gh_user }}" hidden>
  <h2>
    <a href="https://github.com/{{ gh_user }}" style="color: inherit">github activity</a>
  </h2>
  <div class="gh-contrib-scroll">
    <svg class="gh-contrib-svg" role="img" aria-label="GitHub contributions in the last year"></svg>
  </div>
  <p class="gh-contrib-total"></p>
</div>

<style>
  .gh-contrib-scroll {
    overflow-x: auto;
  }
  .gh-contrib-svg {
    display: block;
    width: 100%;
    min-width: 560px;
    max-width: 770px;
    height: auto;
  }
  .gh-contrib-svg text {
    font-size: 10px;
    fill: var(--global-text-color-light);
  }
  .gh-contrib-total {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--global-text-color-light) !important;
  }
  .gh-contrib .l0 {
    fill: #ebedf0;
  }
  .gh-contrib .l1 {
    fill: #9be9a8;
  }
  .gh-contrib .l2 {
    fill: #40c463;
  }
  .gh-contrib .l3 {
    fill: #30a14e;
  }
  .gh-contrib .l4 {
    fill: #216e39;
  }
  html[data-theme='dark'] .gh-contrib .l0 {
    fill: #2d333b;
  }
  html[data-theme='dark'] .gh-contrib .l1 {
    fill: #0e4429;
  }
  html[data-theme='dark'] .gh-contrib .l2 {
    fill: #006d32;
  }
  html[data-theme='dark'] .gh-contrib .l3 {
    fill: #26a641;
  }
  html[data-theme='dark'] .gh-contrib .l4 {
    fill: #39d353;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('gh-contrib');
    if (!root || !window.fetch) return;
    var user = root.getAttribute('data-user');
    var NS = 'http://www.w3.org/2000/svg';
    var CELL = 11,
      STEP = 14,
      LEFT = 30,
      TOP = 16;
    var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function el(name, attrs, text) {
      var node = document.createElementNS(NS, name);
      for (var k in attrs) node.setAttribute(k, attrs[k]);
      if (text) node.textContent = text;
      return node;
    }

    fetch('https://github-contributions-api.jogruber.de/v4/' + encodeURIComponent(user) + '?y=last')
      .then(function (res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.json();
      })
      .then(function (data) {
        var days = data.contributions || [];
        if (!days.length) return;
        var svg = root.querySelector('svg');
        var offset = new Date(days[0].date + 'T00:00:00Z').getUTCDay();
        var weeks = Math.ceil((days.length + offset) / 7);
        svg.setAttribute('viewBox', '0 0 ' + (LEFT + weeks * STEP) + ' ' + (TOP + 7 * STEP));

        [
          ['Mon', 1],
          ['Wed', 3],
          ['Fri', 5],
        ].forEach(function (d) {
          svg.appendChild(el('text', { x: 0, y: TOP + d[1] * STEP + 9 }, d[0]));
        });

        var lastMonth = -1,
          lastLabelWeek = -10;
        days.forEach(function (day, i) {
          var date = new Date(day.date + 'T00:00:00Z');
          var week = Math.floor((i + offset) / 7);
          var dow = date.getUTCDay();
          if (dow === 0 || i === 0) {
            var m = date.getUTCMonth();
            if (m !== lastMonth && date.getUTCDate() <= 7 && week - lastLabelWeek >= 3) {
              svg.appendChild(el('text', { x: LEFT + week * STEP, y: 10 }, MONTHS[m]));
              lastLabelWeek = week;
            }
            lastMonth = m;
          }
          var rect = el('rect', {
            x: LEFT + week * STEP,
            y: TOP + dow * STEP,
            width: CELL,
            height: CELL,
            rx: 2,
            class: 'l' + Math.max(0, Math.min(4, day.level || 0)),
          });
          var label =
            day.count +
            (day.count === 1 ? ' contribution' : ' contributions') +
            ' on ' +
            MONTHS[date.getUTCMonth()] +
            ' ' +
            date.getUTCDate() +
            ', ' +
            date.getUTCFullYear();
          rect.appendChild(el('title', {}, label));
          svg.appendChild(rect);
        });

        var total = data.total && data.total.lastYear;
        if (typeof total === 'number') {
          root.querySelector('.gh-contrib-total').textContent = total + ' contributions in the last year';
        }
        root.hidden = false;
      })
      .catch(function () {
        /* keep the section hidden if the data cannot be loaded */
      });
  })();
</script>
